#!/bin/sh
# Forms staged Swift sources, then re-stages them so the commit matches the tree.
set -e

command -v swiftformat >/dev/null 2>&1 || {
  echo "pre-commit: swiftformat not installed, skipping" >&2
  exit 0
}

root=$(git rev-parse --show-toplevel)
list=$(mktemp)
trap 'rm -f "$list"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' > "$list"
[ -s "$list" ] || exit 0

xargs -0 swiftformat --quiet < "$list"
xargs -0 "$root/scripts/fix-type-blank-lines.py" < "$list"
xargs -0 git add < "$list"
